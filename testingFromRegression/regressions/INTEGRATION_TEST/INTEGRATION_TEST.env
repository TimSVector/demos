ENVIRO.NEW
ENVIRO.NAME:INTEGRATION_TEST
ENVIRO.BASE_DIRECTORY: baseDirectory=$(VCAST_BASE_DIR)/
ENVIRO.COVERAGE_TYPE:Statement+MCDC
ENVIRO.INDUSTRY_MODE:Default
ENVIRO.STUB_BY_FUNCTION:database
ENVIRO.STUB_BY_FUNCTION:manager
ENVIRO.WHITE_BOX:YES
ENVIRO.MAX_VARY_RANGE: 20
ENVIRO.STUB: ALL_BY_PROTOTYPE
ENVIRO.SEARCH_LIST: $(baseDirectory)\database\inc
ENVIRO.SEARCH_LIST: $(baseDirectory)\database\src
ENVIRO.SEARCH_LIST: $(baseDirectory)\order_entry\inc
ENVIRO.SEARCH_LIST: $(baseDirectory)\order_entry\src
ENVIRO.SEARCH_LIST: $(baseDirectory)\utils\inc
ENVIRO.SEARCH_LIST: $(baseDirectory)\utils\src
ENVIRO.SEARCH_LIST: $(baseDirectory)\main
ENVIRO.TYPE_HANDLED_DIRS_ALLOWED:
ENVIRO.LIBRARY_STUBS:
ENVIRO.END
